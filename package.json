{
  "name": "recruiter-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "High-value CS, ML and SWE career events at UNC, Duke, NC State and from tech companies, with phone alerts",
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "notify": "node scripts/notify.mjs notify.json",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "refresh": "npm run ingest && npm run build"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
